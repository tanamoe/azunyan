{
  "name": "azunyan",
  "description": "Tana.moe's Discord utilities bot",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node26.12.1 --format=esm --packages=external --outfile=build/app.js",
    "start": "node --env-file .env build/app.js",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "author": "catou",
  "license": "ISC",
  "type": "module",
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --staged --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "node": ">=20.14.0"
  },
  "packageManager": "pnpm@12.9.0",
  "dependencies": {
    "@atproto/api": "^0.29.5",
    "@atproto/identity": "^0.5.20",
    "@types/better-sqlite3": "^9.6.0",
    "@types/turndown": "^5.0.5",
    "better-sqlite3": "^13.0.3",
    "bgutils-js": "^4.0.3",
    "cheerio": "^1.1.2",
    "consola": "^3.4.2",
    "discord-api-types": "^0.38.21",
    "discord.js": "^14.22.1",
    "ofetch": "^1.4.1",
    "turndown": "^7.2.1",
    "ufo": "^1.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.0",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2"
  }
}
